# -----------------------------------------------------------------------------
# .gitignore for scaling_bench
#
# Keep code under git (bench.py, endtoend_bench.py, launchers, plot scripts).
# Ignore generated plots/CSVs, SLURM outputs, and python bytecode.
# Run logs (runs/, runs_endtoend/) are intentionally tracked / trackable.
# D-PDLP primal/dual solution dumps are huge and not needed — ignore them.
# -----------------------------------------------------------------------------

# D-PDLP solution vectors (multi-GB each; summaries + run.log are enough)
*_primal_solution.txt
*_dual_solution.txt

# Generated plots
plots/

# Consolidated CSVs (rebuild with build_csv.py / endtoend_build_csv.py)
results.csv
results_endtoend_*.csv
report.tsv

# SLURM stdout/stderr (one per crun -b submission)
slurm-*.out

# Ephemeral scratch used by ee_loop's retry logic
ee_retry.log

# OpenMPI/PMIx session dirs rerouted off /tmp by _dpdlp_env
tmp_dpdlp/

# Atomic worker-coordination files (regenerated on the fly)
.claims/
**/.claims/

# Python bytecode / caches
__pycache__/
*.pyc
*.pyo

# Editor / OS junk
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
